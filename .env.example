# Copy to .env and edit. Every variable is optional except DOPPEL_ADMIN_TOKEN.
# Nothing here is a cloud credential: the service makes no outbound calls.

# --- Authentication (required unless DOPPEL_AUTH_DISABLED=true, local development only) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"   (min 16 chars)
DOPPEL_ADMIN_TOKEN=
# Optional second token that may only search (not import/delete/inspect jobs)
DOPPEL_SEARCH_TOKEN=
DOPPEL_AUTH_DISABLED=false

# --- Storage (all local) ---
DOPPEL_DATA_DIR=data
DOPPEL_MODELS_DIR=models
# Allow POST /v1/gallery/import {directory: ...} relative to this root (unset = disabled)
# DOPPEL_IMPORT_ROOT=/photos

# --- Models ---
# sface (production) | fake (tests only)
DOPPEL_PIPELINE=sface
DOPPEL_REQUIRE_MODELS_AT_STARTUP=true
# model copies = max concurrent inferences
DOPPEL_INFERENCE_INSTANCES=2
# OpenCV threads per inference
DOPPEL_INFERENCE_THREADS=1
# detector input is downscaled to this longest side
DOPPEL_DETECT_MAX_SIDE=1280

# --- Limits ---
DOPPEL_MAX_UPLOAD_BYTES=10485760
DOPPEL_MAX_PIXELS=40000000
DOPPEL_MAX_DIMENSION=10000
DOPPEL_MAX_IMPORT_FILES=200
DOPPEL_MIN_FACE_PX=40
DOPPEL_MIN_DETECTION_SCORE=0.80
DOPPEL_MIN_SHARPNESS=15
# 2nd-largest face >= ratio * largest => "multiple faces" error
DOPPEL_AMBIGUITY_RATIO=0.5
DOPPEL_MAX_RESULTS_CAP=100

# --- Matching ---
# Vendor-suggested SFace cosine threshold; replace with a value calibrated on YOUR data
DOPPEL_SAME_PERSON_MIN_SIMILARITY=0.363
# DOPPEL_CALIBRATION_FILE=data/calibration.json   (output of scripts/evaluate.py)
DOPPEL_INDEX_THREADS=2

# --- Security ---
DOPPEL_RATE_LIMIT_PER_MINUTE=120
DOPPEL_SEARCH_RATE_LIMIT_PER_MINUTE=30
# Comma-separated browser origins allowed to call the API (empty = no CORS)
DOPPEL_CORS_ORIGINS=
DOPPEL_URL_TTL_S=3600
# DOPPEL_URL_SIGNING_KEY=          (default: random key persisted in data/url_signing.key)
# DOPPEL_PUBLIC_BASE_URL=https://faces.example.lan

# --- Worker ---
DOPPEL_WORKER_CONCURRENCY=2
DOPPEL_JOB_MAX_ATTEMPTS=3
DOPPEL_JOB_LEASE_S=300
# true = run the worker inside the API process (small installs)
DOPPEL_EMBEDDED_WORKER=false

# --- Server (run.py / Docker) ---
DOPPEL_HOST=127.0.0.1
DOPPEL_PORT=8000
DOPPEL_LOG_LEVEL=INFO
